# Copy to .env and replace every "change-me" value. Never commit .env.
# Values below suit running the backend directly on Windows against local services.
# docker-compose.yml overrides the host names (db, redis, mailpit) for containers.

# ---- PostgreSQL passwords (used by docker compose and the bootstrap script) ----
POSTGRES_PASSWORD=change-me-postgres
DATAMEDIC_DB_MIGRATOR_PASSWORD=change-me-migrator
DATAMEDIC_DB_APP_PASSWORD=change-me-app
DATAMEDIC_DB_MAINTENANCE_PASSWORD=change-me-maintenance
DATAMEDIC_DB_NAME=datamedic

# ---- Database URLs (one role per purpose; see docs/DATABASE_SCHEMA.md §5) ----
# Superuser URL: only for the one-off bootstrap that creates roles + database.
DATAMEDIC_BOOTSTRAP_ADMIN_URL=postgresql+psycopg://postgres:change-me-postgres@localhost:5432/postgres
# Schema owner: only for Alembic migrations.
DATAMEDIC_MIGRATION_DATABASE_URL=postgresql+psycopg://dm_migrator:change-me-migrator@localhost:5432/datamedic
# API + workers (subject to Row-Level Security).
DATAMEDIC_DATABASE_URL=postgresql+psycopg://dm_app:change-me-app@localhost:5432/datamedic
# Scheduled maintenance tasks only (BYPASSRLS).
DATAMEDIC_MAINTENANCE_DATABASE_URL=postgresql+psycopg://dm_maintenance:change-me-maintenance@localhost:5432/datamedic

# ---- Backend ----
DATAMEDIC_ENVIRONMENT=development
DATAMEDIC_REDIS_URL=redis://localhost:6379/0
# Development without Redis: run jobs inside the API process (refused in production).
DATAMEDIC_JOBS_EAGER=false
# Private storage directory (development filesystem adapter). Never served publicly.
DATAMEDIC_STORAGE_ROOT=./var/storage
DATAMEDIC_WEB_ORIGIN=http://localhost:3000
DATAMEDIC_PUBLIC_WEB_URL=http://localhost:3000
# false only for plain-HTTP local development; production requires true.
DATAMEDIC_COOKIE_SECURE=false
# smtp (Mailpit in docker compose) | console (prints emails; dev only)
DATAMEDIC_EMAIL_BACKEND=smtp
DATAMEDIC_SMTP_HOST=localhost
DATAMEDIC_SMTP_PORT=1025
DATAMEDIC_MAX_UPLOAD_BYTES=209715200

# ---- Frontend (inlined at build time) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
