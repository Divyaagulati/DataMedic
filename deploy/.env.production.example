# DataMedic production settings. Copy to .env.production on the server (never commit it) and
# replace every value. Generate secrets with:  openssl rand -hex 24
# The production database starts empty: never copy development data or credentials here.

# Public host name. A domain you control, or a free <ip-with-dashes>.sslip.io name
# (e.g. 203-0-113-10.sslip.io) that resolves to the server's IP.
DATAMEDIC_DOMAIN=CHANGE-ME.sslip.io
# Let's Encrypt registration / expiry notices.
ACME_EMAIL=you@example.com

# Database and Redis secrets (long random values).
POSTGRES_PASSWORD=CHANGE-ME
DATAMEDIC_DB_MIGRATOR_PASSWORD=CHANGE-ME
DATAMEDIC_DB_APP_PASSWORD=CHANGE-ME
DATAMEDIC_DB_MAINTENANCE_PASSWORD=CHANGE-ME
REDIS_PASSWORD=CHANGE-ME

# Outbound email for account verification and password reset (required: users must verify
# their address before uploading). Any SMTP provider with STARTTLS (587) or SSL (465).
DATAMEDIC_SMTP_HOST=smtp.example.com
DATAMEDIC_SMTP_PORT=587
DATAMEDIC_SMTP_SECURITY=starttls
DATAMEDIC_SMTP_USERNAME=CHANGE-ME
DATAMEDIC_SMTP_PASSWORD=CHANGE-ME
DATAMEDIC_SMTP_FROM=DataMedic <no-reply@your-domain.example>

# Demo limits (MVP: synthetic or non-sensitive data only).
DATAMEDIC_MAX_UPLOAD_BYTES=52428800
DATAMEDIC_MAX_DATASETS_PER_USER=10
DATAMEDIC_PARSE_MEMORY_LIMIT_MB=1500
DATAMEDIC_WORKER_MEMORY_LIMIT_MB=1800
# Image tag for rollback (docs/DEPLOYMENT.md).
DATAMEDIC_RELEASE=latest
